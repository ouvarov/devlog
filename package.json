{
  "name": "devlog",
  "private": true,
  "description": "Task tracker for an engineering team with in-product AI agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "npm run build -w @devlog/shared",
    "predev": "node scripts/check-node-version.mjs && npm run build -w @devlog/shared",
    "dev": "concurrently -k -n shared,api,web -c blue,green,magenta \"npm run dev -w @devlog/shared\" \"npm run dev -w @devlog/api\" \"npm run dev -w @devlog/web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test scripts/*.test.mjs && npm test -w @devlog/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "npm run db:reset -w @devlog/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.3",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
